@prefix category: <http://example.org/flora-tristan/feminist_category/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix ex: <http://example.org/flora-tristan/place/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix placetype: <http://example.org/flora-tristan/place_type/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:FT_1 a crm:E53_Place ;
    rdfs:label "Casa de la tía"@en ;
    ex:genderSignificance "Feminized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_1 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_1/Appellation> ;
    crm:P2_has_type category:GENDERED_SPACE,
        category:POLITICAL_SPACE,
        placetype:meeting_place,
        placetype:residence ;
    crm:P3_has_note "Described as a domestic space where political discussion among elite women occurred. Identified as a gendered space in feminist spatial analysis."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_1 .

ex:FT_10 a crm:E53_Place ;
    rdfs:label "Congreso"@en ;
    ex:genderSignificance "Masculinized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_10 ;
    crm:P168_place_is_defined_by ex:Geo_FT_10 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_10/Appellation> ;
    crm:P2_has_type category:POLITICAL_SPACE,
        placetype:government_building ;
    crm:P3_has_note "Seat of legislative debate, observed by Flora Tristán with symbolic gendered segregation and critique of performative masculinity in politics."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_10 .

ex:FT_11 a crm:E53_Place ;
    rdfs:label "Baños de mar"@en ;
    ex:genderSignificance "Mixed"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_11 ;
    crm:P168_place_is_defined_by ex:Geo_FT_11 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_11/Appellation> ;
    crm:P2_has_type category:PUBLIC_CIVIC_SPACE,
        <http://example.org/flora-tristan/place_type/leisure/seashore_space> ;
    crm:P3_has_note "Women’s access to ocean bathing represents embodied spatial freedom. Tristán presents it as a sign of physical strength and cultural independence."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_11 .

ex:FT_12 a crm:E53_Place ;
    rdfs:label "Teatro de Lima"@en ;
    ex:genderSignificance "Mixed"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_12 ;
    crm:P168_place_is_defined_by ex:Geo_FT_12 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_12/Appellation> ;
    crm:P2_has_type category:CULTURAL_SPACE,
        category:PUBLIC_CIVIC_SPACE,
        placetype:performance,
        placetype:theater ;
    crm:P3_has_note "A prominent theater in Lima where artistic performances and cultural events took place during the 19th century."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_12 .

ex:FT_13 a crm:E53_Place ;
    rdfs:label "Plaza de acho"@en ;
    ex:genderSignificance "Mixed"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_13 ;
    crm:P168_place_is_defined_by ex:Geo_FT_13 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_13/Appellation> ;
    crm:P2_has_type category:CULTURAL_SPACE,
        category:GENDERED_SPACE,
        category:PUBLIC_CIVIC_SPACE,
        placetype:performance,
        placetype:theater ;
    crm:P3_has_note "One of the oldest bullfighting arenas in the Americas, located in Lima, and historically significant for public spectacles and gatherings."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_13 .

ex:FT_2 a crm:E53_Place ;
    rdfs:label "Catedral de Lima"@en ;
    ex:genderSignificance "Masculinized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_2 ;
    crm:P168_place_is_defined_by ex:Geo_FT_2 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_2/Appellation> ;
    crm:P2_has_type category:POLITICAL_SPACE,
        category:RELIGIOUS_SPACE,
        placetype:church ;
    crm:P3_has_note "Religious and symbolic center of Lima, exclusively male clerical hierarchy"@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_2 .

ex:FT_3 a crm:E53_Place ;
    rdfs:label "Municipalidad"@en ;
    ex:genderSignificance "Masculinized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_3 ;
    crm:P168_place_is_defined_by ex:Geo_FT_3 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_3/Appellation> ;
    crm:P2_has_type category:POLITICAL_SPACE,
        placetype:government_building ;
    crm:P3_has_note "Symbol of institutional political authority (no women)"@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_3 .

ex:FT_4 a crm:E53_Place ;
    rdfs:label "Plaza Mayor"@en ;
    ex:genderSignificance "Mixed"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_4 ;
    crm:P168_place_is_defined_by ex:Geo_FT_4 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_4/Appellation> ;
    crm:P2_has_type category:POLITICAL_SPACE,
        category:PUBLIC_CIVIC_SPACE,
        category:SYMBOLIC_SPACE,
        placetype:civic_square,
        placetype:marketplace ;
    crm:P3_has_note "Mixed-use civic space; includes economic activities, military processions, and street vendors"@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_4 .

ex:FT_5 a crm:E53_Place ;
    rdfs:label "Convento de San Francisco"@en ;
    ex:genderSignificance "Feminized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_5 ;
    crm:P168_place_is_defined_by ex:Geo_FT_5 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_5/Appellation> ;
    crm:P2_has_type category:GENDERED_SPACE,
        category:RELIGIOUS_SPACE,
        placetype:church,
        placetype:monastery ;
    crm:P3_has_note "Highly symbolic male religious space, where gendered exclusion and moral critique are explicit."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_5 .

ex:FT_6 a crm:E53_Place ;
    rdfs:label "Convento de la Encarnacion"@en ;
    ex:genderSignificance "Feminized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_6 ;
    crm:P168_place_is_defined_by ex:Geo_FT_6 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_6/Appellation> ;
    crm:P2_has_type category:GENDERED_SPACE,
        category:RELIGIOUS_SPACE,
        placetype:monastery ;
    crm:P3_has_note "Female convent described as a site of informal independence and institutional decay. A symbolic gendered space."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_6 .

ex:FT_7 a crm:E53_Place ;
    rdfs:label "Callao (Puerto)"@en ;
    ex:genderSignificance "Masculinized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_7 ;
    crm:P168_place_is_defined_by ex:Geo_FT_7 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_7/Appellation> ;
    crm:P2_has_type category:ECONOMIC_SPACE,
        category:POLITICAL_SPACE,
        placetype:military_site,
        placetype:port ;
    crm:P3_has_note "Port of Lima and site of military fortresses. Described in passing, possibly symbolic of masculine power structures."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_7 .

ex:FT_8 a crm:E53_Place ;
    rdfs:label "Casa de la Moneda"@en ;
    ex:genderSignificance "Masculinized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_8 ;
    crm:P168_place_is_defined_by ex:Geo_FT_8 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_8/Appellation> ;
    crm:P2_has_type category:ECONOMIC_SPACE,
        category:POLITICAL_SPACE,
        placetype:mint ;
    crm:P3_has_note "Modernized monetary facility described positively as efficient and technologically updated."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_8 .

ex:FT_9 a crm:E53_Place ;
    rdfs:label "Prisiones de la Inquisición"@en ;
    ex:genderSignificance "Masculinized"@en ;
    crm:P160_has_temporal_projection ex:TimeSpan_FT_9 ;
    crm:P168_place_is_defined_by ex:Geo_FT_9 ;
    crm:P1_is_identified_by <http://example.org/flora-tristan/place/FT_9/Appellation> ;
    crm:P2_has_type category:CARCERAL_SPACE,
        category:RELIGIOUS_SPACE,
        placetype:prison,
        placetype:religious_building ;
    crm:P3_has_note "Former prison of the Holy Inquisition; emotionally described as oppressive and terrifying."@en ;
    crm:P67_refers_to ex:EmotionsStatement_FT_9 .

